#!/usr/bin/env python3
"""File operations in flight, with real progress.

No external tool needed: a process copying, downloading or hashing a file holds an fd on
it, /proc/PID/fdinfo/N carries that descriptor's byte offset, and stat gives the size.
Offset over size is the progress bar. Sampling the offset twice would give a rate, but a
provider runs once per tick, so the rate is derived from the previous tick's offset held
in the cache instead.
"""
import json
import os
import pathlib
import time

WATCH = {"cp", "mv", "rsync", "curl", "wget", "dd", "tar", "gzip", "zstd", "xz",
         "sha256sum", "md5sum", "cpio", "rclone", "scp", "sftp", "ffmpeg", "pv"}
STATE = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or pathlib.Path.home() / ".cache") / "omarchy-cockpit"
MARKS = STATE / "transfer-marks.json"
MIN_SIZE = 8 * 1024 * 1024      # below this it is over before a bar could render


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024


def main():
    now = time.time()
    try:
        marks = json.loads(MARKS.read_text())
    except Exception:
        marks = {}
    fresh, rows = {}, []

    for proc in pathlib.Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            comm = (proc / "comm").read_text().strip()
        except Exception:
            continue
        if comm not in WATCH:
            continue
        try:
            fds = list((proc / "fd").iterdir())
        except Exception:
            continue    # another user's process, or it exited between the two calls

        best = None
        for fd in fds:
            try:
                target = fd.resolve()
                if not target.is_file():
                    continue
                size = target.stat().st_size
                if size < MIN_SIZE:
                    continue
                info = (proc / "fdinfo" / fd.name).read_text()
                pos = next((int(l.split()[1]) for l in info.splitlines() if l.startswith("pos:")), 0)
            except Exception:
                continue
            # The largest file this process is touching is the one worth showing; a copy
            # also holds its destination, and a tar holds dozens of small members.
            if best is None or size > best[1]:
                best = (target, size, pos)

        if not best:
            continue
        target, size, pos = best
        key = f"{proc.name}:{target}"
        prev = marks.get(key)
        rate = ""
        if prev and now > prev["at"]:
            delta = pos - prev["pos"]
            seconds = now - prev["at"]
            if delta > 0 and seconds > 0.5:
                per_sec = delta / seconds
                remaining = (size - pos) / per_sec if per_sec > 0 else 0
                eta = f" · {int(remaining//60)}m{int(remaining%60):02d}s left" if remaining > 90 else \
                      (f" · {int(remaining)}s left" if remaining > 1 else "")
                rate = f" · {human(per_sec)}/s{eta}"
        fresh[key] = {"pos": pos, "at": now}

        pct = int(100 * pos / size) if size else 0
        rows.append({
            "glyph": "󰄠",
            "title": f"{comm}  {target.name}",
            "detail": f"{human(pos)} of {human(size)}{rate}",
            "state": "busy",
            "progress": max(0, min(100, pct)),
        })

    STATE.mkdir(parents=True, exist_ok=True)
    tmp = MARKS.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(fresh))
    tmp.replace(MARKS)

    rows.sort(key=lambda r: -r["progress"])
    print(json.dumps({"section": "Transfers", "glyph": "󰇚", "priority": 20,
                      "intervalSec": 1, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
