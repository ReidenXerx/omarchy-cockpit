#!/usr/bin/python3
"""Whether a reboot is owed, and why.

On Arch the running kernel and the installed one drift apart silently after an update,
and nothing in the desktop says so. It matters more than usual with an out-of-tree
graphics driver: the module has to match the running kernel, so the gap between "updated"
and "rebooted" is the window where things break in confusing ways.

Silent when there is nothing to report, which is most of the time.
"""
import json
import os
import pathlib
import stat
import sys
import time

sys.dont_write_bytecode = True  # no __pycache__ in the plugin (the shell watches it)
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "bin"))
import plugin_safety as safe  # noqa: E402
import cockpit_common as common  # noqa: E402

# Packages whose update is only actually in effect after a reboot.
#
# Kernels are deliberately not in this list. Updating a kernel you do not boot owes you
# nothing, and on a machine that boots something other than `linux` -- linux-omarchy here,
# but -lts and -zen are the same story -- counting every kernel would nag forever. The one
# kernel that matters is the running one, handled by running_kernel_package() below.
CRITICAL = ("nvidia", "nvidia-open", "nvidia-dkms", "nvidia-open-dkms",
            "systemd", "intel-ucode", "amd-ucode", "mesa")
PACMAN_LOCAL = "/var/lib/pacman/local"
LOCAL_ENTRIES_MAX = 50000


def pacman_version(pkg):
    try:
        r = safe.run(["pacman", "-Q", pkg], timeout=4, max_output=4096)
    except (OSError, safe.UnsafeError):
        return ""
    parts = r.text().split()
    return parts[1] if r.ok and len(parts) >= 2 else ""


def running_kernel_package():
    """The package providing the running kernel, or "" if nothing owns it.

    Asking pacman who owns the running kernel's modules beats assuming `linux`: this
    machine boots linux-omarchy on purpose, so comparing against `linux` reported a
    reboot was owed every minute of every day.
    """
    modules = pathlib.Path("/usr/lib/modules") / os.uname().release
    if not modules.is_dir():
        return None          # the running kernel has been replaced on disk
    try:
        r = safe.run(["pacman", "-Qoq", str(modules)], timeout=4, max_output=4096)
    except (OSError, safe.UnsafeError):
        return ""
    if not r.ok:
        return ""
    # Two packages own that directory: the kernel and its -headers, which puts build/
    # there. Order is not guaranteed, so pick by name rather than by luck.
    owners = [n.strip() for n in r.text().strip().splitlines() if n.strip()]
    kernels = [n for n in owners if not n.endswith(("-headers", "-docs"))]
    return (kernels or owners or [""])[0]


def normalise(v):
    """pacman writes 7.2.4.arch1-2 where uname reports 7.2.4-arch1-2. Compare on digits
    and letters alone so the two spellings of the same version match."""
    return "".join(ch for ch in v if ch.isalnum())


def installed_at(packages):
    """{pkg: newest install time} from pacman's local database, whose entries are named
    <name>-<version>-<rel>. Directory metadata only; nothing is read or followed."""
    newest = dict.fromkeys(packages, 0.0)
    try:
        with os.scandir(PACMAN_LOCAL) as it:
            for n, entry in enumerate(it):
                if n >= LOCAL_ENTRIES_MAX:
                    break
                for pkg in packages:
                    # "nvidia-utils-580..." is not "nvidia": a version starts with a digit.
                    if entry.name.startswith(pkg + "-") and entry.name[len(pkg) + 1:][:1].isdigit():
                        try:
                            st = entry.stat(follow_symlinks=False)
                        except OSError:
                            continue
                        if stat.S_ISDIR(st.st_mode):
                            newest[pkg] = max(newest[pkg], st.st_mtime)
    except OSError:
        pass
    return newest


def main():
    running = os.uname().release
    pkg = running_kernel_package()
    up = common.uptime()

    if pkg is None:
        # No module directory for the kernel we are running: it was replaced underneath
        # us, which is the one case where a reboot is unarguable.
        installed, kernel_stale = "", True
    elif pkg:
        installed = pacman_version(pkg)
        kernel_stale = bool(installed) and normalise(installed) not in normalise(running)
    else:
        # Owned by nothing -- a hand-built kernel. Not our business to nag about.
        installed, kernel_stale = "", False

    now = time.time()
    stamps = installed_at(CRITICAL)
    stale_pkgs = [pkg for pkg, at in stamps.items() if at and up and (now - at) < up]

    rows = []
    if kernel_stale or stale_pkgs:
        # One row, not one per package: these are all the same fact -- a reboot is owed --
        # and listing them separately makes a single condition look like three problems.
        what = []
        if kernel_stale:
            what.append(f"kernel {installed or 'replaced'}")
        what.extend(stale_pkgs)
        rows.append({
            "glyph": "󰜉",
            "title": "Reboot pending",
            "detail": (f"running {running} · updated since boot: " + ", ".join(what))
                      if what else "updates applied since boot",
            "state": "warn",
        })

    print(json.dumps({"section": "Reboot", "glyph": "󰜉", "priority": 5,
                      "intervalSec": 300, "timeoutSec": 6, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
