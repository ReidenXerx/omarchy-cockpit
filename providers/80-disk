#!/usr/bin/env python3
"""Filesystems worth worrying about, and volumes that are not mounted.

Quiet by design: a disk at 58% is not news. Only speaks past a threshold, or when a drive
you normally use is absent.
"""
import json
import pathlib
import shutil
import subprocess

WARN_PERCENT = 85
IGNORE_TYPES = {"tmpfs", "devtmpfs", "squashfs", "overlay", "efivarfs", "ramfs"}


def main():
    rows = []
    try:
        out = subprocess.run(["findmnt", "-rno", "TARGET,FSTYPE,SOURCE"],
                             capture_output=True, text=True, timeout=6).stdout
    except Exception:
        out = ""

    seen = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        target, fstype, source = parts[0], parts[1], parts[2]
        if fstype in IGNORE_TYPES or not source.startswith("/dev/") or source in seen:
            continue
        seen.add(source)
        try:
            usage = shutil.disk_usage(target)
        except Exception:
            continue
        pct = 100.0 * usage.used / usage.total if usage.total else 0
        if pct < WARN_PERCENT:
            continue
        rows.append({
            "glyph": "\U000f02ca",
            "title": target,
            "detail": f"{pct:.0f}% full · {usage.free / 1024**3:.0f}GB free",
            "state": "warn",
            "progress": int(pct),
        })

    # A large unmounted filesystem is usually a drive you mount on demand -- worth a line
    # so "where are my games" is answered without opening a file manager.
    try:
        blk = json.loads(subprocess.run(
            ["lsblk", "-Jo", "NAME,SIZE,FSTYPE,MOUNTPOINT,LABEL"],
            capture_output=True, text=True, timeout=6).stdout)
    except Exception:
        blk = {}

    def walk(nodes):
        for n in nodes:
            fstype = n.get("fstype") or ""
            if fstype and fstype not in ("swap",) and not n.get("mountpoint"):
                size = str(n.get("size", ""))
                label = n.get("label") or n.get("name")
                rows.append({
                    "glyph": "\U000f02ca",
                    "title": f"{label} not mounted",
                    "detail": f"{size} · {fstype}",
                    "state": "idle",
                    "action": f"udisksctl mount -b /dev/{n.get('name')}",
                })
            walk(n.get("children") or [])
    walk(blk.get("blockdevices") or [])

    print(json.dumps({"section": "Disks", "glyph": "\U000f02ca", "priority": 80,
                      "intervalSec": 60, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
