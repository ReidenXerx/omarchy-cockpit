#!/usr/bin/python3
"""Agent sessions and what each one is doing -- working, waiting for you, idle -- and the
chats that ended, one click from coming back.

Claude Code sessions report their own status (see bin/cockpit_agents.py). Each row says what
the session is doing, in which project and branch, and on which workspace; a click focuses
its window, and a button opens the project folder.

A chat that ended stays for a day, from the history cockpit-agentd keeps: a click resumes it
in your terminal, in its folder (`claude --resume <id>`), and Dismiss hides it until that
chat ends again.

Other terminal agents only advertise themselves in the window title, as a spinner glyph
that turns while they stream output. For those the daemon records when each title last
changed. A spinner goes quiet during a long tool call, so those rows say "last active"
rather than claiming the agent is idle.
"""
import json
import pathlib
import stat
import sys
import time

sys.dont_write_bytecode = True  # no __pycache__ in the plugin (the shell watches it)
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "bin"))
import plugin_safety as safe  # noqa: E402
import cockpit_common as common  # noqa: E402
import cockpit_agents as agents  # noqa: E402

STATE = common.state_dir()
SEEN = STATE / "agent-titles.json"
LIVE = STATE / "agent-state.json"      # written by cockpit-agentd
STATE_MAX = 1024 * 1024
TITLE_MAX = agents.TITLE_MAX
RANK = {"needs": 0, "busy": 1, "idle": 2}

# One Material Design glyph, from the Nerd Font the bar already uses, per thing a session can
# be doing: the icon alone should say it.
STATUS_GLYPHS = {
    "waiting": chr(0xF009E),   # md-bell_ring: needs you
    "busy": chr(0xF0996),      # md-progress_clock: working
    "shell": chr(0xF07B7),     # md-console_line: a background command it started still runs
    "idle": chr(0xF05E1),      # md-check_circle_outline: done, waiting for your next message
}
OTHER_GLYPH = chr(0xF0493)     # md-cog: a status this version does not know yet (compacting, ...)
ENDED_GLYPH = chr(0xF02DA)     # md-history
RESUME_GLYPH = chr(0xF099B)    # md-restore
FOLDER_GLYPH = chr(0xF0770)    # md-folder_open
ROBOT_GLYPH = chr(0xF06A9)     # md-robot: an agent known only from its window title

# Chats that ended are offered back for a day, and at most this many: the section is for what
# is happening, and older chats are one `claude --resume` away.
ENDED_WITHIN = 24 * 3600
ENDED_MAX = 8

# How long after the last title change a title-only session still counts as working. The
# spinner turns a few times a second while busy, so anything under a couple of seconds
# would flicker; much more and a finished session lingers as "working".
BUSY_WINDOW = 4.0

# Terminal emulators worth inspecting for title-only agents. Anything else is a normal app.
TERMINALS = {"foot", "dev.warp.Warp", "Alacritty", "kitty", "com.mitchellh.ghostty",
             "org.wezfurlong.wezterm", "xterm-256color", "konsole"}


def load(path):
    try:
        data = safe.read_json(path, STATE_MAX, default={}, max_depth=4, max_items=8192,
                              max_string=4 * TITLE_MAX)
    except (OSError, safe.UnsafeError):
        return {}
    return data if isinstance(data, dict) else {}


def folder_button(cwd):
    """The project folder, while it is still a folder."""
    if not cwd or common.lstat_kind(cwd) != stat.S_IFDIR:
        return None
    action = common.action_or_none({"kind": "open-folder", "path": cwd})
    return {"glyph": FOLDER_GLYPH, "label": "Open the project folder", "action": action} if action else None


def place(cwd):
    """ "project (branch)", "project" or "" -- where a session works, at a glance."""
    project = agents.project_of(cwd)
    branch = agents.branch_of(cwd) if project else ""
    return f"{project} ({branch})" if branch else project


# ------------------------------------------------------------------ Claude Code sessions

def session_row(session, window, now):
    since = session["since"]
    age = agents.elapsed(int(now - since)) if 0 < since <= now else ""
    for_age = f" for {age}" if age else ""
    status = session["status"]
    if status == "waiting":
        reason = agents.reason_of(session)
        state, label = "needs", "needs you" + (f": {reason}" if reason else "")
    elif status == "busy":
        state, label = "busy", "working" + for_age
    elif status == "shell":
        # The turn is over, but a background command the session started is still running.
        # Claude Code counts that as working, and something is in motion, so it is busy.
        state, label = "busy", "working in background" + for_age
    elif status == "idle":
        state, label = "idle", "idle" + for_age
    else:
        state, label = "idle", status.replace("_", " ") + for_age

    task = ""
    if window is not None:
        title_glyph, text = agents.split_glyph(window["title"])
        if title_glyph in agents.CLAUDE_TITLE_GLYPHS:
            task = text
        where = f"ws{window['ws']}"
    else:
        where = "background" if session["kind"] not in ("", "interactive") else "no window"
    row = {
        "glyph": STATUS_GLYPHS.get(status, OTHER_GLYPH),
        "title": common.clean_text(task or session["name"] or agents.project_of(session["cwd"]) or "Claude Code",
                                   TITLE_MAX),
        "detail": " · ".join(part for part in (label, place(session["cwd"]), where) if part),
        "state": state,
    }
    if window is not None:
        # Clicking jumps straight to that session, which is the point of not switching.
        action = common.action_or_none({"kind": "focus-window", "address": window["address"]})
        if action:
            row["action"] = action
    folder = folder_button(session["cwd"])
    if folder:
        row["buttons"] = [folder]
    return row


def ended_rows(history, live_ids, now):
    """The chats that ended in the last day, newest first. A click resumes one; Dismiss hides it
    until it ends again, since the marker is when it ended."""
    ended = sorted(((sid, entry) for sid, entry in history.items()
                    if sid not in live_ids and entry["endedAt"] and 0 <= now - entry["endedAt"] <= ENDED_WITHIN),
                   key=lambda item: item[1]["endedAt"], reverse=True)
    rows = []
    for sid, entry in ended:
        if len(rows) >= ENDED_MAX:
            break
        cwd = entry["cwd"]
        if not cwd or common.lstat_kind(cwd) != stat.S_IFDIR:
            continue   # nowhere left to resume it from
        resume = common.action_or_none({"kind": "resume-agent", "session": sid, "cwd": cwd})
        if resume is None:
            continue
        ago = f"ended {agents.elapsed(int(now - entry['endedAt']))} ago"
        row = {
            "glyph": ENDED_GLYPH,
            "title": common.clean_text(entry["title"] or entry["name"] or agents.project_of(cwd) or "Claude Code",
                                       TITLE_MAX),
            "detail": " · ".join(part for part in (ago, place(cwd)) if part),
            "state": "idle",
            "action": resume,
            "buttons": [{"glyph": RESUME_GLYPH, "label": "Resume this chat in a terminal", "action": resume}],
            "dismiss": {"key": sid, "marker": str(int(entry["endedAt"]))},
        }
        folder = folder_button(cwd)
        if folder:
            row["buttons"].append(folder)
        rows.append(row)
    return rows


# ------------------------------------------------------------------ title-only agents

def title_rows(windows, claimed, now):
    seen = load(SEEN)
    live = load(LIVE)   # daemon not running yet: everything reads as waiting, never as an error
    fresh, rows = {}, []
    for w in windows:
        addr = w["address"]
        if addr in claimed or w["class"] not in TERMINALS:
            continue
        glyph, task = agents.split_glyph(w["title"])
        if not glyph and addr not in live:
            continue  # a plain-titled terminal the daemon has never seen is just a shell

        prev = seen.get(addr) if isinstance(seen.get(addr), dict) else {}

        # Busy comes from the daemon, not from this poll. hyprctl serves a cached title:
        # sampled ten times in two seconds it returns the identical glyph while the
        # compositor's event socket is reporting the spinner turning. The daemon holds
        # that socket open and records when each title actually last changed.
        watched = live.get(addr) if isinstance(live.get(addr), dict) else {}
        last_change = common.number(watched.get("changedAt"))
        busy = last_change > 0 and (now - last_change) < BUSY_WINDOW
        # Prefer the daemon's title: it is the live one.
        if isinstance(watched.get("title"), str) and watched["title"]:
            glyph, task = agents.split_glyph(watched["title"][:TITLE_MAX])

        since = common.number(prev.get("since"), now) if prev.get("task") == task else now
        fresh[addr] = {"glyph": glyph, "task": task, "since": since}

        # Time since the title last MOVED, from the daemon -- not since the task text
        # changed. Falls back to the task age if the daemon has not seen this window yet.
        reference = last_change if last_change > 0 else since
        age = max(0, int(now - reference))
        row = {
            "glyph": ROBOT_GLYPH,
            "title": common.clean_text(task, TITLE_MAX) or "(no task)",
            # "last active" rather than "idle": a title spinner only turns while the agent
            # streams output, so silence is not proof that nothing is happening.
            "detail": f"ws{w['ws']} · {common.clean_text(w['class'], 64)} · "
                      + ("working" if busy else f"last active {agents.elapsed(age)}"),
            "state": "busy" if busy else "idle",
        }
        action = common.action_or_none({"kind": "focus-window", "address": addr})
        if action:
            row["action"] = action
        rows.append(row)

    try:
        safe.write_json(SEEN, fresh)
    except (OSError, safe.UnsafeError):
        pass
    return rows


def main():
    now = time.time()
    clients = common.hypr_clients() or []
    windows = [w for w in map(agents.window_info, clients[:agents.CLIENTS_MAX]) if w is not None]
    by_pid = {}
    for w in windows:
        if w["pid"] is not None:
            by_pid.setdefault(w["pid"], []).append(w)

    rows, claimed, live_ids = [], set(), set()
    for session in agents.read_sessions():
        window = agents.window_for(session["pid"], by_pid)
        if window is not None:
            claimed.add(window["address"])
        if session["sessionId"]:
            live_ids.add(session["sessionId"])
        rows.append(session_row(session, window, now))
    rows += title_rows(windows, claimed, now)

    # What needs you first, then what is working: those are what you opened the hub for. The
    # chats that ended come after everything that is still running.
    rows.sort(key=lambda r: (RANK.get(r["state"], 2), r["title"]))
    rows += ended_rows(agents.load_history(), live_ids, now)

    print(json.dumps({
        "section": "Agents", "glyph": ROBOT_GLYPH, "priority": 10, "intervalSec": 2, "timeoutSec": 6,
        "rows": rows
    }, ensure_ascii=False))


if __name__ == "__main__":
    main()
