#!/usr/bin/python3
"""Agent sessions and what each one is doing: working, waiting for you, or idle.

Claude Code keeps a status record for every running session in
~/.claude/sessions/<pid>.json: "busy" for the whole of a turn, tool calls included;
"waiting" when something needs you -- a question, a permission or other dialog, a sandbox
request -- with the reason in `waitingFor`; and "idle" once it is done. That record is
the truth for those sessions. It is tied to a window by walking up from the session's
process to the one that owns a Hyprland window, and a record is trusted only while its
pid still names the process that wrote it (the start time must match).

Other terminal agents only advertise themselves in the window title, as a spinner glyph
that turns while they stream output. For those the daemon records when each title last
changed. A spinner goes quiet during a long tool call, so those rows say "last active"
rather than claiming the agent is idle.
"""
import json
import pathlib
import re
import stat
import sys
import time

sys.dont_write_bytecode = True  # no __pycache__ in the plugin (the shell watches it)
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "bin"))
import plugin_safety as safe  # noqa: E402
import cockpit_common as common  # noqa: E402

STATE = common.state_dir()
SEEN = STATE / "agent-titles.json"
LIVE = STATE / "agent-state.json"      # written by cockpit-agentd
STATE_MAX = 1024 * 1024
TITLE_MAX = 256
CLIENTS_MAX = 512

CLAUDE_SESSIONS = pathlib.Path(common.HOME) / ".claude" / "sessions"
SESSIONS_MAX = 64
SESSION_FILE_MAX = 16 * 1024
SESSION_LIMITS = {"max_depth": 4, "max_items": 256, "max_string": 4096}
SESSION_FILE = re.compile(r"([1-9][0-9]{0,9})\.json")
PROC_START = re.compile(r"[0-9]{1,20}")
STATUSES = ("busy", "waiting", "idle")
PARENT_DEPTH = 32
# What Claude Code puts in front of its terminal title: two glyphs that alternate while it
# animates and one while it is still. Used to pick its window out of several that belong
# to one terminal process, and to take the task text from the title.
CLAUDE_TITLE_GLYPHS = ("◐", "◑", "✳")
# `waitingFor` as Claude Code writes it, shortened for a glance. A reason not listed here
# is shown as written.
WAITING_FOR = {
    "input needed": "question",
    "dialog open": "prompt open",
    "sandbox request": "sandbox request",
    "worker request": "worker request",
    "goal proposal": "goal proposal",
}
RANK = {"needs": 0, "busy": 1, "idle": 2}

# How long after the last title change a title-only session still counts as working. The
# spinner turns a few times a second while busy, so anything under a couple of seconds
# would flicker; much more and a finished session lingers as "working".
BUSY_WINDOW = 4.0

# Terminal emulators worth inspecting for title-only agents. Anything else is a normal app.
TERMINALS = {"foot", "dev.warp.Warp", "Alacritty", "kitty", "com.mitchellh.ghostty",
             "org.wezfurlong.wezterm", "xterm-256color", "konsole"}


# A leading non-alphanumeric glyph followed by text is the shape every one of these
# tools uses. Matching the SHAPE rather than a list of glyphs is what makes this survive
# a tool changing its spinner.
def split_glyph(title):
    t = (title or "").strip()
    if not t:
        return "", ""
    first = t[0]
    if first.isalnum() or first in "/~.(<[\"'":
        return "", t
    return first, t[1:].strip()


def load(path):
    try:
        data = safe.read_json(path, STATE_MAX, default={}, max_depth=4, max_items=8192,
                              max_string=4 * TITLE_MAX)
    except (OSError, safe.UnsafeError):
        return {}
    return data if isinstance(data, dict) else {}


def elapsed(age):
    return f"{age // 3600}h {age % 3600 // 60}m" if age >= 3600 else (f"{age // 60}m" if age >= 60 else f"{age}s")


def text_field(raw, key, limit):
    value = raw.get(key)
    return common.clean_text(value, limit) if isinstance(value, str) else ""


# ------------------------------------------------------------------ processes and windows

def proc_fields(pid):
    """/proc/<pid>/stat fields after the command name (state first), or None."""
    content = common.proc_read(pid, "stat", 4096)
    if not content or ")" not in content:
        return None
    return content[content.rfind(")") + 2:].split()


def same_process(pid, proc_start):
    # starttime is field 22 of /proc/<pid>/stat, index 19 once pid and comm are cut off.
    # A pid is reused after its process exits; the start time is what proves the record
    # still describes the process running now.
    fields = proc_fields(pid)
    return fields is not None and len(fields) > 19 and fields[19] == proc_start


def window_info(client):
    if not isinstance(client, dict) or not client.get("mapped"):
        return None
    address = client.get("address")
    if not isinstance(address, str) or not common.ADDRESS.fullmatch(address):
        return None
    pid = client.get("pid")
    workspace = client.get("workspace")
    cls = client.get("class")
    return {
        "address": address,
        "pid": pid if isinstance(pid, int) and not isinstance(pid, bool) and pid > 1 else None,
        "class": cls if isinstance(cls, str) else "",
        "title": (client.get("title") if isinstance(client.get("title"), str) else "")[:TITLE_MAX],
        "ws": common.clean_text(workspace.get("name", "?"), 32) if isinstance(workspace, dict) else "?",
    }


def window_for(pid, by_pid):
    """The window a process runs in: the nearest ancestor that owns one."""
    for _ in range(PARENT_DEPTH):
        candidates = by_pid.get(pid)
        if candidates:
            if len(candidates) == 1:
                return candidates[0]
            # One terminal process with several windows (a foot server, ghostty, kitty in
            # single-instance mode). Only a window titled the way Claude Code titles its
            # terminal can be told apart, and only if exactly one is.
            titled = [w for w in candidates if split_glyph(w["title"])[0] in CLAUDE_TITLE_GLYPHS]
            return titled[0] if len(titled) == 1 else None
        fields = proc_fields(pid)
        if fields is None or len(fields) < 2 or not fields[1].isdigit():
            return None
        pid = int(fields[1])
        if pid <= 1:
            return None
    return None


# ------------------------------------------------------------------ Claude Code sessions

def parse_session(raw, pid):
    """The fields this provider uses from one session record, checked; None if unusable."""
    if not isinstance(raw, dict):
        return None
    if isinstance(raw.get("pid"), bool) or raw.get("pid") != pid:
        return None
    proc_start = raw.get("procStart")
    if isinstance(proc_start, int) and not isinstance(proc_start, bool):
        proc_start = str(proc_start)
    if not isinstance(proc_start, str) or not PROC_START.fullmatch(proc_start):
        return None
    status = raw.get("status")
    if status not in STATUSES:
        return None   # an older Claude Code without status: its title still shows it
    kind = raw.get("kind")
    return {
        "pid": pid,
        "procStart": proc_start,
        "status": status,
        "waitingFor": text_field(raw, "waitingFor", 64),
        "needs": text_field(raw, "needs", 160),
        "since": common.number(raw.get("statusUpdatedAt")) / 1000,
        "name": text_field(raw, "name", 64),
        "kind": kind if isinstance(kind, str) else "",
    }


def read_sessions():
    """Live Claude Code sessions. A missing directory, a foreign or symlinked file, a record
    over its caps or one whose process is gone is simply not a session."""
    try:
        entries = safe.list_dir(CLAUDE_SESSIONS, max_entries=4 * SESSIONS_MAX)
    except (OSError, safe.UnsafeError):
        return []
    sessions = []
    for name, st in entries:
        match = SESSION_FILE.fullmatch(name)
        if not match or not stat.S_ISREG(st.st_mode):
            continue
        try:
            raw = safe.read_json(CLAUDE_SESSIONS / name, SESSION_FILE_MAX, default=None, **SESSION_LIMITS)
        except (OSError, safe.UnsafeError):
            continue
        session = parse_session(raw, int(match.group(1)))
        if session is not None and same_process(session["pid"], session["procStart"]):
            sessions.append(session)
            if len(sessions) >= SESSIONS_MAX:
                break
    return sessions


def session_row(session, window, now):
    since = session["since"]
    age = elapsed(int(now - since)) if 0 < since <= now else ""
    if session["status"] == "waiting":
        reason = session["needs"] or WAITING_FOR.get(session["waitingFor"], session["waitingFor"])
        glyph, state, label = "●", "needs", "needs you" + (f": {reason}" if reason else "")
    elif session["status"] == "busy":
        glyph, state, label = "◐", "busy", "working" + (f" for {age}" if age else "")
    else:
        glyph, state, label = "✳", "idle", "idle" + (f" for {age}" if age else "")

    title = ""
    if window is not None:
        title_glyph, task = split_glyph(window["title"])
        if title_glyph in CLAUDE_TITLE_GLYPHS:
            title = task
        where = f"ws{window['ws']}"
    else:
        where = "background" if session["kind"] not in ("", "interactive") else "no window"
    row = {
        "glyph": glyph,
        "title": common.clean_text(title or session["name"] or "Claude Code", TITLE_MAX),
        "detail": f"{label} · {where} · Claude",
        "state": state,
    }
    if window is not None:
        # Clicking jumps straight to that session, which is the point of not switching.
        action = common.action_or_none({"kind": "focus-window", "address": window["address"]})
        if action:
            row["action"] = action
    return row


# ------------------------------------------------------------------ title-only agents

def title_rows(windows, claimed, now):
    seen = load(SEEN)
    live = load(LIVE)   # daemon not running yet: everything reads as waiting, never as an error
    fresh, rows = {}, []
    for w in windows:
        addr = w["address"]
        if addr in claimed or w["class"] not in TERMINALS:
            continue
        glyph, task = split_glyph(w["title"])
        if not glyph and addr not in live:
            continue  # a plain-titled terminal the daemon has never seen is just a shell

        prev = seen.get(addr) if isinstance(seen.get(addr), dict) else {}

        # Busy comes from the daemon, not from this poll. hyprctl serves a cached title:
        # sampled ten times in two seconds it returns the identical glyph while the
        # compositor's event socket is reporting the spinner turning. The daemon holds
        # that socket open and records when each title actually last changed.
        watched = live.get(addr) if isinstance(live.get(addr), dict) else {}
        last_change = common.number(watched.get("changedAt"))
        busy = last_change > 0 and (now - last_change) < BUSY_WINDOW
        # Prefer the daemon's title: it is the live one.
        if isinstance(watched.get("title"), str) and watched["title"]:
            glyph, task = split_glyph(watched["title"][:TITLE_MAX])

        since = common.number(prev.get("since"), now) if prev.get("task") == task else now
        fresh[addr] = {"glyph": glyph, "task": task, "since": since}

        # Time since the title last MOVED, from the daemon -- not since the task text
        # changed. Falls back to the task age if the daemon has not seen this window yet.
        reference = last_change if last_change > 0 else since
        age = max(0, int(now - reference))
        row = {
            "glyph": glyph,
            "title": common.clean_text(task, TITLE_MAX) or "(no task)",
            # "last active" rather than "idle": a title spinner only turns while the agent
            # streams output, so silence is not proof that nothing is happening.
            "detail": f"ws{w['ws']} · {common.clean_text(w['class'], 64)} · "
                      + ("working" if busy else f"last active {elapsed(age)}"),
            "state": "busy" if busy else "idle",
        }
        action = common.action_or_none({"kind": "focus-window", "address": addr})
        if action:
            row["action"] = action
        rows.append(row)

    try:
        safe.write_json(SEEN, fresh)
    except (OSError, safe.UnsafeError):
        pass
    return rows


def main():
    now = time.time()
    clients = common.hypr_clients() or []
    windows = [w for w in map(window_info, clients[:CLIENTS_MAX]) if w is not None]
    by_pid = {}
    for w in windows:
        if w["pid"] is not None:
            by_pid.setdefault(w["pid"], []).append(w)

    rows, claimed = [], set()
    for session in read_sessions():
        window = window_for(session["pid"], by_pid)
        if window is not None:
            claimed.add(window["address"])
        rows.append(session_row(session, window, now))
    rows += title_rows(windows, claimed, now)

    # What needs you first, then what is working: those are what you opened the hub for.
    rows.sort(key=lambda r: (RANK.get(r["state"], 2), r["title"]))

    print(json.dumps({
        "section": "Agents", "glyph": "󰚩", "priority": 10, "intervalSec": 2, "timeoutSec": 6,
        "rows": rows
    }, ensure_ascii=False))


if __name__ == "__main__":
    main()
