#!/usr/bin/python3
"""Pending updates, without touching the network on every tick.

checkupdates syncs a temporary database rather than the system one, so it is safe to run
without root and cannot leave pacman in a partial-sync state. Its cost is real though, so
this provider declares a long interval and the runner caches it. The three sources are
asked at once, each under its own deadline, so together they fit the 30 s budget.
"""
import concurrent.futures
import json
import pathlib
import sys

sys.dont_write_bytecode = True  # no __pycache__ in the plugin (the shell watches it)
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "bin"))
import plugin_safety as safe  # noqa: E402
import cockpit_common as common  # noqa: E402

SOURCE_TIMEOUT = 25
OUTPUT_MAX = 1024 * 1024


def count(argv):
    try:
        r = safe.run(argv, timeout=SOURCE_TIMEOUT, max_output=OUTPUT_MAX)
    except (OSError, safe.UnsafeError):
        return None
    # checkupdates exits 2 when there is simply nothing to do.
    if r.timed_out or r.truncated or r.returncode not in (0, 2):
        return None
    return len([l for l in r.text().splitlines() if l.strip()])


def row(glyph, title, detail, argv):
    out = {"glyph": glyph, "title": title, "detail": detail, "state": "warn"}
    action = common.action_or_none({"kind": "terminal", "argv": argv})
    if action:
        out["action"] = action
    return out


def plural(n, word):
    return f"{n} {word}{'s' if n != 1 else ''}"


def main():
    helper = next((h for h in ("yay", "paru") if safe.has_tool(h)), None)
    jobs = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        if safe.has_tool("checkupdates"):
            jobs["pacman"] = pool.submit(count, ["checkupdates"])
        if helper:
            jobs["aur"] = pool.submit(count, [helper, "-Qua"])
        if safe.has_tool("flatpak"):
            jobs["flatpak"] = pool.submit(count, ["flatpak", "remote-ls", "--updates"])
    found = {name: job.result() for name, job in jobs.items()}

    rows = []
    if found.get("pacman"):
        rows.append(row("󰏔", plural(found["pacman"], "official package"), "pacman", ["checkupdates"]))
    if found.get("aur"):
        rows.append(row("󰣇", plural(found["aur"], "AUR package"), helper, [helper, "-Qua"]))
    if found.get("flatpak"):
        rows.append(row("󰏖", plural(found["flatpak"], "flatpak"), "flatpak", ["flatpak", "update"]))

    print(json.dumps({"section": "Updates", "glyph": "󰚰", "priority": 50,
                      # Quarter of an hour: nothing here changes faster than that, and
                      # each source costs a network round trip.
                      "intervalSec": 900, "timeoutSec": 30, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
