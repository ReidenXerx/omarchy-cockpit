#!/usr/bin/env python3
"""Pending updates, without touching the network on every tick.

checkupdates syncs a temporary database rather than the system one, so it is safe to run
without root and cannot leave pacman in a partial-sync state. Its cost is real though, so
this provider declares a long interval and the runner caches it.
"""
import json
import shutil
import subprocess


def count(cmd, timeout=25):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None
    # checkupdates exits 2 when there is simply nothing to do.
    if r.returncode not in (0, 2):
        return None
    return len([l for l in r.stdout.splitlines() if l.strip()])


def main():
    rows = []

    if shutil.which("checkupdates"):
        n = count(["checkupdates"])
        if n:
            rows.append({"glyph": "󰏔", "title": f"{n} official package{'s' if n != 1 else ''}",
                         "detail": "pacman", "state": "warn",
                         "action": "omarchy-launch-floating-terminal-with-presentation checkupdates"})

    for helper in ("yay", "paru"):
        if shutil.which(helper):
            n = count([helper, "-Qua"])
            if n:
                rows.append({"glyph": "󰣇", "title": f"{n} AUR package{'s' if n != 1 else ''}",
                             "detail": helper, "state": "warn",
                             "action": f"omarchy-launch-floating-terminal-with-presentation {helper} -Qua"})
            break

    if shutil.which("flatpak"):
        n = count(["flatpak", "remote-ls", "--updates"], timeout=30)
        if n:
            rows.append({"glyph": "󰏖", "title": f"{n} flatpak{'s' if n != 1 else ''}",
                         "detail": "flatpak", "state": "warn",
                         "action": "omarchy-launch-floating-terminal-with-presentation flatpak update"})

    print(json.dumps({"section": "Updates", "glyph": "󰚰", "priority": 50,
                      # Quarter of an hour: nothing here changes faster than that, and
                      # each source costs a network round trip.
                      "intervalSec": 900, "timeoutSec": 60, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
