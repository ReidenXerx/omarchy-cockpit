#!/usr/bin/env python3
"""Long-running commands started from a shell, with elapsed time.

The builds, installs and test runs you kicked off in some other workspace and stopped
watching. Anything a shell is a parent of, older than a threshold, that is not a shell,
an editor or a daemon.
"""
import json
import os
import pathlib
import time

SHELLS = {"bash", "zsh", "fish", "sh", "dash"}
# Things that are legitimately long-lived and would otherwise fill the section forever.
BORING = SHELLS | {
    "nvim", "vim", "emacs", "hx", "helix", "less", "man", "ssh", "tmux", "screen",
    "node", "claude", "codex", "python3", "ollama", "docker", "btop", "htop", "watch",
    "cockpit-agentd", "kb-layout-daemon", "foot", "warp-terminal", "socat",
}
# Already shown, with progress, in the Transfers section.
TRANSFERS = {"cp", "mv", "rsync", "curl", "wget", "dd", "tar", "sha256sum", "ffmpeg"}
MIN_AGE = 20.0
# Session infrastructure that does hold a tty and would otherwise sit here for the whole
# uptime. Matched on the command line, because the binary alone (systemctl) is legitimate.
BORING_PATTERNS = ("--wait wayland-session", "uwsm", "session-envelope", "dbus-run-session")


def clock_ticks():
    try:
        return os.sysconf("SC_CLK_TCK")
    except Exception:
        return 100


def uptime():
    return float(pathlib.Path("/proc/uptime").read_text().split()[0])


def main():
    hz, up, rows = clock_ticks(), uptime(), []
    procs = {}

    for entry in pathlib.Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text()
            comm = (entry / "comm").read_text().strip()
        except Exception:
            continue
        # comm can contain spaces and parens, so read the fields after the last ')'.
        tail = stat[stat.rfind(")") + 2:].split()
        try:
            ppid = int(tail[1])
            tty = int(tail[4])
            starttime = int(tail[19])
        except Exception:
            continue
        procs[int(entry.name)] = (comm, ppid, up - starttime / hz, entry, tty)

    for pid, (comm, ppid, age, entry, tty) in procs.items():
        if comm in BORING or comm in TRANSFERS or age < MIN_AGE:
            continue
        # A controlling terminal is what separates "something you typed" from session
        # plumbing. journalctl -f and systemctl --wait are started without one and would
        # otherwise sit in this list for the life of the session.
        if tty == 0:
            continue
        parent = procs.get(ppid)
        # Only jobs a shell started: everything else is a service or a child of an app.
        if not parent or parent[0] not in SHELLS:
            continue
        try:
            cmdline = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace").strip()
        except Exception:
            cmdline = comm
        if any(pat in cmdline for pat in BORING_PATTERNS):
            continue
        mins, secs = int(age // 60), int(age % 60)
        elapsed = f"{mins//60}h {mins%60:02d}m" if mins >= 60 else (f"{mins}m {secs:02d}s" if mins else f"{secs}s")
        rows.append({
            "glyph": "󰅢",
            "title": (cmdline or comm)[:70],
            "detail": f"running {elapsed} · pid {pid}",
            "state": "busy",
        })

    rows.sort(key=lambda r: r["title"])
    print(json.dumps({"section": "Jobs", "glyph": "󰅢", "priority": 30,
                      "intervalSec": 5, "rows": rows}, ensure_ascii=False))


if __name__ == "__main__":
    main()
